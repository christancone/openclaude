4DX2529029AND001', sn: '4006', tracking_no: '170001777769 - 1', status: 'new'}, {page_uid: 'e55162e7-d2b7-4975-849e-724bea636f77', pn: '604DX2529029AND001', sn: '4007', tracking_no: '170001777769 - 1', status: 'new'}, {page_uid: 'ed2e782c-9aa4-4f1f-8124-5751552fec14', pn: 'AV16B2177-3', sn: 'AA441157', tracking_no: '283704', status: 'repaired'}, {page_uid: 'ed2e782c-9aa4-4f1f-8124-5751552fec14', pn: '601-62900-7', sn: 'AA441157', tracking_no: '283704', status: 'repaired'}, {page_uid: 'ff5bca2b-a379-48c9-94aa-1cb102898310', pn: '3800804-2', sn: 'P-535', tracking_no: '20180005350537Y14, 8007791853-10', status: 'new'}, {page_uid: '45a2b2e7-1967-4874-9ab0-8482ce724c84', pn: '600-59151-11', sn: '090520021095E', tracking_no: null, status: 'inspected'}, {page_uid: '45a2b2e7-1967-4874-9ab0-8482ce724c84', pn: '601R59041-3', sn: '0905200213796', tracking_no: null, status: 'inspected'}, {page_uid: '681b8c55-0242-434b-80c7-2159fb049b9d', pn: '1015FASA-6K4-1-150', sn: '10UL-02703', tracking_no: '10UL-02793', status: 'new'}, {page_uid: 'b9ac8701-8132-4477-b560-8565887fb7c2', pn: '3800804-2', sn: 'P-535', tracking_no: '20180005350537Y14 8007791853-10', status: 'new'}, {page_uid: 'f3410b0e-6729-49f7-84ea-f9d545ff417d', pn: '1015FASA-6K4-1-150', sn: '10UL-02703', tracking_no: '10UL-02793', status: 'new'}, {page_uid: '83818df0-d0e7-42e9-b33e-fd242f9b3dcf', pn: '1015FASA-6K4-1-150', sn: '10UL-02792', tracking_no: '10UL-02792', status: 'new'}, {page_uid: 'dfe4af68-03c1-4627-99fa-f00d05fc0f87', pn: '600-59151-11', sn: '090520021095E', tracking_no: null, status: 'inspected'}, {page_uid: 'dfe4af68-03c1-4627-99fa-f00d05fc0f87', pn: '601R59041-3', sn: '0905200213796', tracking_no: null, status: 'inspected'}, {page_uid: '5b7e4894-8748-40ff-8331-71295c462e2d', pn: '600-59151-11', sn: '090520021095E', tracking_no: null, status: 'inspected'}, {page_uid: '5b7e4894-8748-40ff-8331-71295c462e2d', pn: '601R59041-3', sn: '0905200213796', tracking_no: null, status: 'inspected'}, {page_uid: '98d0f57c-93f7-4d15-b968-835784e190b2', pn: '3800804-2', sn: 'P-535', tracking_no: '20180005350537Y14 8007791853-10', status: 'new'}, {page_uid: 'a3676b82-41e2-46a6-b9b0-558916d140dd', pn: '6089T11G01', sn: '801539', tracking_no: 'DWD2018-36', status: 'new'}
] AS payload

        UNWIND payload AS p
        MATCH (page:Page {value: p.page_uid})-[:CARRIES]->(f:Form1)
        OPTIONAL MATCH (c:Component {asset_id: f.asset_id})-[:HAS_SN]->(sn:SerialNumber {value: p.sn})
        WITH p, f, c
        WHERE c IS NOT NULL
        OPTIONAL MATCH (c)-[:HAS_PRIMARY_PN]->(pn_c:PartNumber)
        WITH p, f, c, pn_c
        WHERE pn_c IS NOT NULL
          AND (pn_c.value = p.pn
            OR pn_c.normalized = replace(replace(replace(replace(toUpper(p.pn),' ',''),'-',''),'_',''),'/','')
            OR EXISTS {
              MATCH (pn_paper:PartNumber {asset_id: f.asset_id, value: p.pn})-[a:ALIAS_OF]->(pn_c)
              WHERE a.kind IN ['ocr_variant','incomplete_pn']
            }
            OR EXISTS {
              MATCH (pn_paper:PartNumber {asset_id: f.asset_id, value: p.pn})<-[a:ALIAS_OF]-(pn_c)
              WHERE a.kind IN ['ocr_variant','incomplete_pn']
            })
        MERGE (f)-[r:RELEASES_STRUCT]->(c)
          ON CREATE SET r.source            = 'csv_structural',
                        r.confidence        = 'high',
                        r.disposition       = p.status,
                        r.form_tracking_no  = p.tracking_no,
                        r.block             = '8+10',
                        r.phase             = 'migration_form1_csv_2026_05_19'
        RETURN count(DISTINCT r) AS releases_struct
    ;
